# CF-4: Better Auth Environment Foundation
# DO NOT add real production secrets here.
# This file serves as a reference for environment variables required by Better Auth.

# Base Auth URL (used by Next.js edge and Better Auth to verify trusted origins)
BETTER_AUTH_URL=http://localhost:3000

# Better Auth Secret (used for signing sessions/cookies)
BETTER_AUTH_SECRET=placeholder_secret_key

# Database Connection
# In local development, you might use Wrangler or local D1 bindings, 
# but process.env.DB usually comes from Cloudflare Workers bindings.
# If connecting directly via HTTP to D1 from Node (Next.js dev server), you might need:
# CLOUDFLARE_ACCOUNT_ID=placeholder
# CLOUDFLARE_DATABASE_ID=placeholder
# CLOUDFLARE_D1_TOKEN=placeholder

# OAuth Providers
GOOGLE_CLIENT_ID=placeholder_google_id
GOOGLE_CLIENT_SECRET=placeholder_google_secret

FACEBOOK_CLIENT_ID=placeholder_facebook_id
FACEBOOK_CLIENT_SECRET=placeholder_facebook_secret

TWITTER_CLIENT_ID=placeholder_twitter_id
TWITTER_CLIENT_SECRET=placeholder_twitter_secret

LINKEDIN_CLIENT_ID=placeholder_linkedin_id
LINKEDIN_CLIENT_SECRET=placeholder_linkedin_secret

# Email Provider for Magic Links (e.g. Resend)
EMAIL_PROVIDER_API_KEY=placeholder_email_key
